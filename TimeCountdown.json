{
    "id": "com.mikasa1995.sap.timecountdown",
    "version": "1.0.0",
    "name": "Time Countdown",
    "description": "A custom widget to show a countdown with prefix text and style configuration",
    "newInstancePrefix": "MikasaCountdown",
    "vendor": "Mikasa1995",
    "eula": "",
    "license": "",
    "icon": "https://raw.githubusercontent.com/Mikasa1995/TimeCountdown/main/icon.png",
    "webcomponents": [
        {
            "kind": "main",
            "tag": "com-mikasa1995-sap-timecountdown",
            "url": "https://cdn.jsdelivr.net/gh/Mikasa1995/TimeCountdown@main/TimeCountdown.js",
            "integrity": "",
            "ignoreIntegrity": true
        },
        {
            "kind": "builder",
            "tag": "com-mikasa1995-sap-timecountdown-builder",
            "url": "https://cdn.jsdelivr.net/gh/Mikasa1995/TimeCountdown@main/TimeCountdown_Builder.js",
            "integrity": "",
            "ignoreIntegrity": true
        }
    ],
    "properties": {
        "date": {
            "description": "Target date in ISO format",
            "type": "string",
            "default": "2099-01-01T00:00"
        },
        "prefixText": {
            "description": "Prefix text displayed above the countdown",
            "type": "string",
            "default": "Time until project go-live"
        },
        "prefixColor": {
            "description": "Color of the prefix text",
            "type": "string",
            "default": "#cccccc"
        },
        "countdownColor": {
            "description": "Color of the countdown text",
            "type": "string",
            "default": "#ffffff"
        },
        "backgroundColor": {
            "description": "Background color of the widget",
            "type": "string",
            "default": "#333333"
        },
        "captionaftercountdown": {
            "description": "Text displayed after the countdown ends",
            "type": "string",
            "default": "Project is live"
        }
    },
    "methods": {
        "setDate": {
            "description": "Set the target date",
            "parameters": [
                { "name": "date", "type": "string", "description": "Target date" }
            ],
            "body": "this.date = date;"
        },
        "getDate": {
            "returnType": "string",
            "description": "Get the target date",
            "body": "return this.date;"
        },
        "setPrefixText": {
            "description": "Set the prefix text",
            "parameters": [
                { "name": "prefixText", "type": "string", "description": "Prefix text" }
            ],
            "body": "this.prefixText = prefixText;"
        },
        "getPrefixText": {
            "returnType": "string",
            "description": "Get the prefix text",
            "body": "return this.prefixText;"
        },
        "setPrefixColor": {
            "description": "Set the prefix text color",
            "parameters": [
                { "name": "prefixColor", "type": "string", "description": "Color value" }
            ],
            "body": "this.prefixColor = prefixColor;"
        },
        "setCountdownColor": {
            "description": "Set the countdown text color",
            "parameters": [
                { "name": "countdownColor", "type": "string", "description": "Color value" }
            ],
            "body": "this.countdownColor = countdownColor;"
        },
        "setBackgroundColor": {
            "description": "Set the background color",
            "parameters": [
                { "name": "backgroundColor", "type": "string", "description": "Color value" }
            ],
            "body": "this.backgroundColor = backgroundColor;"
        },
        "setCaptionaftercountdown": {
            "description": "Set the caption after countdown",
            "parameters": [
                { "name": "captionaftercountdown", "type": "string", "description": "Caption text" }
            ],
            "body": "this.captionaftercountdown = captionaftercountdown;"
        },
        "getCaptionaftercountdown": {
            "returnType": "string",
            "description": "Get the caption after countdown",
            "body": "return this.captionaftercountdown;"
        }
    },
    "events": {
        "onClick": {
            "description": "User Clicked."
        }
    }
}
